generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  avatarUrl     String?        @map("avatar_url")
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastLoginAt   DateTime?      @map("last_login_at")
  auditLogs     AuditLog[]
  comments      Comment[]
  favorites     Favorite[]
  ratings       Rating[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  watchHistory  WatchHistory[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_id_fkey")
  @@map("refresh_tokens")
}

model Genre {
  id          String       @id @default(uuid())
  slug        String       @unique
  nameVi      String       @map("name_vi")
  nameEn      String       @map("name_en")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  videoGenres VideoGenre[]

  @@map("genres")
}

model Video {
  id              String         @id @default(uuid())
  slug            String         @unique
  titleVi         String         @map("title_vi")
  titleEn         String         @map("title_en")
  descriptionVi   String?        @map("description_vi") @db.Text
  descriptionEn   String?        @map("description_en") @db.Text
  type            VideoType
  year            Int
  posterUrl       String?        @map("poster_url")
  backdropUrl     String?        @map("backdrop_url")
  ageRating       AgeRating      @map("age_rating")
  durationMinutes Int?           @map("duration_minutes")
  isPublished     Boolean        @default(false) @map("is_published")
  viewsCount      BigInt         @default(0) @map("views_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  englishTitle    String?        @map("english_title")
  imagesJson      Json?          @map("images_json")
  imdbId          String?        @map("imdb_id")
  imdbRating      Float?         @map("imdb_rating")
  originCountry   Json?          @map("origin_country")
  originalTitle   String?        @map("original_title")
  overview        String?        @db.Text
  quality         VideoQuality?  @default(HD)
  comments        Comment[]
  favorites       Favorite[]
  movieSources    MovieSource?
  ratings         Rating[]
  seasons         Season[]
  transcodeJobs   TranscodeJob[]
  casts           VideoCast[]
  genres          VideoGenre[]
  watchHistory    WatchHistory[]

  @@map("videos")
}

model Season {
  id           String    @id @default(uuid())
  videoId      String    @map("video_id")
  seasonNumber Int       @map("season_number")
  nameVi       String    @map("name_vi")
  nameEn       String    @map("name_en")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  episodes     Episode[]
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id                    String         @id @default(uuid())
  seasonId              String         @map("season_id")
  episodeNumber         Int            @map("episode_number")
  titleVi               String         @map("title_vi")
  titleEn               String         @map("title_en")
  synopsisVi            String?        @map("synopsis_vi") @db.Text
  synopsisEn            String?        @map("synopsis_en") @db.Text
  runtimeMinutes        Int            @map("runtime_minutes")
  hlsManifestKey        String?        @map("hls_manifest_key")
  trailerHlsManifestKey String?        @map("trailer_hls_manifest_key")
  subtitlesJson         Json?          @map("subtitles_json")
  isPublished           Boolean        @default(false) @map("is_published")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  season                Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory          WatchHistory[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model MovieSource {
  id                    String   @id @default(uuid())
  videoId               String   @unique @map("video_id")
  hlsManifestKey        String?  @map("hls_manifest_key")
  trailerHlsManifestKey String?  @map("trailer_hls_manifest_key")
  subtitlesJson         Json?    @map("subtitles_json")
  isPublished           Boolean  @default(false) @map("is_published")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  rawVideoKey           String?  @map("raw_video_key")
  video                 Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("movie_sources")
}

model VideoGenre {
  videoId String @map("video_id")
  genreId String @map("genre_id")
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, genreId])
  @@index([genreId], map: "video_genres_genre_id_fkey")
  @@map("video_genres")
}

model CastMember {
  id         String      @id @default(uuid())
  name       String
  avatarUrl  String?     @map("avatar_url")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  videoCasts VideoCast[]

  @@map("cast_members")
}

model VideoCast {
  videoId  String     @map("video_id")
  castId   String     @map("cast_id")
  roleName String     @map("role_name")
  cast     CastMember @relation(fields: [castId], references: [id], onDelete: Cascade)
  video    Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, castId])
  @@index([castId], map: "video_casts_cast_id_fkey")
  @@map("video_casts")
}

model Favorite {
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId], map: "favorites_video_id_fkey")
  @@map("favorites")
}

model Rating {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  videoId    String   @map("video_id")
  score      Int
  reviewText String?  @map("review_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId], map: "ratings_video_id_fkey")
  @@map("ratings")
}

model Comment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  videoId   String    @map("video_id")
  parentId  String?   @map("parent_id")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([parentId], map: "comments_parent_id_fkey")
  @@index([userId], map: "comments_user_id_fkey")
  @@index([videoId], map: "comments_video_id_fkey")
  @@map("comments")
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  videoId         String   @map("video_id")
  episodeId       String?  @map("episode_id")
  progressSeconds Int      @map("progress_seconds")
  completed       Boolean  @default(false)
  lastWatchedAt   DateTime @map("last_watched_at")
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([episodeId], map: "watch_history_episode_id_fkey")
  @@index([userId], map: "watch_history_user_id_fkey")
  @@index([videoId], map: "watch_history_video_id_fkey")
  @@map("watch_history")
}

model Subscription {
  id      String             @id @default(uuid())
  userId  String             @map("user_id")
  plan    SubscriptionPlan
  startAt DateTime           @map("start_at")
  endAt   DateTime           @map("end_at")
  status  SubscriptionStatus
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "subscriptions_user_id_fkey")
  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  details    String?  @db.Text
  resourceId String?  @map("resource_id")
  status     String   @default("SUCCESS")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model TranscodeJob {
  id           String          @id @default(uuid())
  videoId      String
  jobId        String          @unique
  status       TranscodeStatus @default(QUEUED)
  progress     Int             @default(0)
  qualities    Json
  inputPath    String
  outputPath   String
  errorMessage String?         @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  video        Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId], map: "transcode_jobs_videoId_fkey")
  @@map("transcode_jobs")
}

enum UserRole {
  GUEST
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
}

enum VideoType {
  MOVIE
  SERIES
}

enum AgeRating {
  G
  PG
  PG13
  R
  NC17
}

enum VideoQuality {
  CAM
  HD
  FHD
  FOURK @map("4K")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TranscodeStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
