# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication
AUTH_COOKIE_NAME=admin_auth_token
NEXT_PUBLIC_AUTH_COOKIE_SECURE=false
NEXT_PUBLIC_AUTH_COOKIE_SAME_SITE=lax

# Internationalization
I18N_DEFAULT_LOCALE=vi
I18N_LOCALES=vi,en

# Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=100MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/*,video/*,text/vtt

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=ChauPhim Admin
NEXT_PUBLIC_APP_VERSION=1.0.0

# Analytics & Monitoring
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_SENTRY_DSN=""

# Feature Flags
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_ENABLE_MSW=true

# CDN & Storage
NEXT_PUBLIC_CDN_BASE_URL=""
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
